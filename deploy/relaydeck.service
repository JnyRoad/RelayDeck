[Unit]
Description=RelayDeck - AI API Gateway Platform
Documentation=https://github.com/JnyRoad/RelayDeck
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=relaydeck
Group=relaydeck
WorkingDirectory=/opt/relaydeck
ExecStart=/opt/relaydeck/relaydeck
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=relaydeck

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/relaydeck

# Environment - Server configuration
# Modify these values to change listen address and port
Environment=GIN_MODE=release
Environment=SERVER_HOST=0.0.0.0
Environment=SERVER_PORT=8080

[Install]
WantedBy=multi-user.target
